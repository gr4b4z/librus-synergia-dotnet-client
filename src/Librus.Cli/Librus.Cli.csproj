<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Librus.Cli</RootNamespace>
    <AssemblyName>librus-net</AssemblyName>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Librus.Api\Librus.Api.csproj" />
    <ProjectReference Include="..\Librus.Poller\Librus.Poller.csproj" />
    <ProjectReference Include="..\Librus.Mcp\Librus.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Librus.Tests" />
  </ItemGroup>
</Project>
