<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
    <Authors>librus-net contributors</Authors>
    <Product>librus-net</Product>
    <Description>Unofficial Librus Synergia .NET client, notification poller and MCP server.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsLibrusLibrary)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
